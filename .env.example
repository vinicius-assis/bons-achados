DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
ML_AFFILIATE_WORD="your-affiliate-word"
AMAZON_AFFILIATE_TAG="your-associates-tag"
AMAZON_CREATORS_CLIENT_ID="your-creators-api-client-id"
AMAZON_CREATORS_CLIENT_SECRET="your-creators-api-client-secret"
# Informational only — no code reads this. The token endpoint is hardcoded
# to the NA region (api.amazon.com) since this app only targets the BR
# marketplace, which is NA. Set it to whatever version Associates Central
# shows next to your credential, for whoever reads this file later.
AMAZON_CREATORS_CREDENTIAL_VERSION="3.1"
SHOPEE_APP_ID="your-shopee-app-id"
SHOPEE_APP_SECRET="your-shopee-app-secret"
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"
# Bearer secret the nightly GitHub Actions cleanup cron sends to
# /api/cron/postdraft-cleanup. The same value must also be set as GitHub repo
# secrets APP_URL + POSTDRAFT_CLEANUP_SECRET (see
# .github/workflows/postdraft-cleanup.yml) and as a Vercel env var for the
# cron to actually run in production.
POSTDRAFT_CLEANUP_SECRET="change-me"
# Bearer secret the nightly GitHub Actions cleanup cron sends to
# /api/cron/highlights-cleanup. The same value must also be set as GitHub repo
# secrets APP_URL + HIGHLIGHTS_CLEANUP_SECRET (see
# .github/workflows/highlights-cleanup.yml) and as a Vercel env var for the
# cron to actually run in production.
HIGHLIGHTS_CLEANUP_SECRET="change-me"
# Bearer secret both GitHub Actions crons (collect.yml every 20 min, and the
# second step of highlights-cleanup.yml) send to /api/cron/collect. The same
# value must also be set as the GitHub repo secret CRON_COLLECT_SECRET (see
# .github/workflows/collect.yml) and as a Vercel env var for the cron to
# actually run in production.
CRON_COLLECT_SECRET="change-me"
